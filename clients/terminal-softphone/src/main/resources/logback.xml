<configuration>
  <!-- Keep the interactive terminal clean: only warnings. Use the 'trace' command to see SIP messages.
       Override with -Dlogback.configurationFile=... for protocol level debugging
       (logger "com.github.mikekwright.sip.softphone.wire" at DEBUG prints every SIP message). -->
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{30} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
